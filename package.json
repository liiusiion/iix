{
  "name": "iix",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch --env-file .env",
    "develop": "docker compose up -d --wait && npm run start:dev",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "lint": "oxlint --fix src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:sync": "npm run db:generate && npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "auth generate --config src/auth.cli.ts --output .better-auth/auth-schema.ts --yes",
    "add:decorator:common": "nest g decorator common/decorators/%npm_config_name% --flat",
    "add:repository": "nest g mo modules/repositories/%npm_config_name% --no-spec && nest g pr modules/repositories/%npm_config_name%/%npm_config_name%Repository --no-spec --flat",
    "add:service": "nest g mo modules/services/%npm_config_name% --no-spec && nest g s modules/services/%npm_config_name%/%npm_config_name% --no-spec --flat",
    "add:client": "nest g mo modules/integrations/%npm_config_name% --no-spec && nest g pr modules/integrations/%npm_config_name%/%npm_config_name%Client --no-spec --flat",
    "add:controller": "nest g co entrypoints/api/%npm_config_name% --no-spec"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.5",
    "@scalar/nestjs-api-reference": "^1.2.31",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^1.0.0-rc.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "auth": "^1.7.14",
    "drizzle-kit": "^1.0.0-rc.5",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
